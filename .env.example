# ==============================================================================
# КОНФИГУРАЦИЯ БОТА МАКС (V1PER IT Solutions Commercial Bot)
# Скопируйте этот файл в .env и укажите свои параметры
# ==============================================================================

# Официальный токен бота из кабинета business.max.ru
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_API_BASE_URL=https://platform-api2.max.ru

# Шлюз мгновенных уведомлений о лидах в Telegram разработчика
TG_NOTIFY_BOT_TOKEN=your_telegram_bot_token_here
TG_NOTIFY_CHAT_ID=your_telegram_chat_id_here

# Параметры локального сервера / вебхука
PORT=8080
HOST=0.0.0.0
WEBHOOK_URL=https://your-domain.ru/webhook

# ID администратора в МАКС (доступ к закрытой админ-панели и получение лидов в ЛС)
ADMIN_MAX_ID=your_max_numeric_id_here

# Реквизиты самозанятого для генерации PDF-смет (Оферта / ЭЦП 63-ФЗ)
SELLER_NAME=V1PER (Самозанятый исполнитель)
SELLER_INN=860200000000
BANK_NAME=АО Т-Банк
BANK_BIK=044525974
BANK_CORR=30101810145250000974
BANK_ACCOUNT=40817810000000000000
PAYMENT_SBP=+79000000000

# Режим отладки (0 - продакшен, 1 - оффлайн эмуляция)
DEMO_MODE=0
