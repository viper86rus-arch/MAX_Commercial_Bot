# ==============================================================================
# КОНФИГУРАЦИЯ БОТА МАКС (V1PER Commercial Bot)
# Скопируйте этот файл в .env и укажите свои параметры
# ==============================================================================

# Официальный токен бота из кабинета business.max.ru
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_API_BASE_URL=https://platform-api2.max.ru

# Шлюз мгновенных уведомлений о лидах в Telegram разработчика
TG_NOTIFY_BOT_TOKEN=your_telegram_bot_token_here
TG_NOTIFY_CHAT_ID=9172025400

# Параметры локального сервера / вебхука
PORT=8080
HOST=0.0.0.0
WEBHOOK_URL=https://your-domain.ru/webhook

# Режим отладки (0 - продакшен, 1 - оффлайн эмуляция)
DEMO_MODE=0
